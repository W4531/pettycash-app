[
  {
    "name": "delete-untagged-after-30-days",
    "action": { "type": "Delete" },
    "condition": {
      "tagState": "untagged",
      "olderThan": "30d"
    }
  },
  {
    "name": "keep-v1-release",
    "action": { "type": "Keep" },
    "condition": {
      "tagState": "tagged",
      "tagPrefixes": ["v1"]
    }
  },
  {
    "name": "keep-newest-version",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "keepCount": 1
    }
  }
]
